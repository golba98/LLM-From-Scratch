#!/usr/bin/env bash
# Current-development launcher. Uses the .venv interpreter and its third-party
# dependencies, but loads the Codexa components from source first
# (workspace_bootstrap), so the repaired architecture is used instead of the
# historical wheels installed in .venv. It never modifies .venv.
#
#   tools/codexa-dev -m llm_inference.cli.chat_native --help
#   tools/codexa-dev scripts/environment_identity.py --expect current
#   tools/codexa-dev                                  # interactive interpreter
#
# Historical reproduction of codexa-934m-foundation-5h-v1 uses .venv without
# this launcher; see documentation/workspace/ENVIRONMENTS.md.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="${CODEXA_PYTHON:-$ROOT/.venv/bin/python}"
# The startup safety guard runs before workspace_bootstrap. Give it the same
# source-first search path that the bootstrap will install inside Python.
export PYTHONPATH="$ROOT/../LLM-Architecture/src:$ROOT/../LLM-Tokenizer/src:$ROOT/../LLM-Data/src:$ROOT/../LLM-Training/src:$ROOT/../LLM-Inference/src:$ROOT/../LLM-Memory/src:$ROOT/../LLM-Specialist/src:$ROOT/src:$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -c '
import code, os, runpy, sys
sys.path.insert(0, sys.argv[1])
import workspace_bootstrap  # noqa: F401  (component src paths first; exported via PYTHONPATH)
args = sys.argv[2:]
if not args:
    code.interact(banner="codexa-dev (source-first components)", local={})
elif args[0] == "-m":
    if len(args) < 2:
        raise SystemExit("codexa-dev: -m requires a module name")
    sys.argv = [args[1], *args[2:]]
    runpy.run_module(args[1], run_name="__main__", alter_sys=True)
else:
    script = os.path.abspath(args[0])
    sys.argv = [script, *args[1:]]
    sys.path.insert(0, os.path.dirname(script))
    runpy.run_path(script, run_name="__main__")
' "$ROOT" "$@"
