# Python, environments and build output
.venv/
.venv-specialist/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Runtime asset directories (only .gitkeep is tracked)
checkpoints/*
logs/*
data/raw/*
data/processed/*
data/tokenized/*
data/memory/
releases/*
backups/*
exports/*
!checkpoints/.gitkeep
!logs/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/tokenized/.gitkeep
!releases/.gitkeep
!backups/.gitkeep
!exports/.gitkeep

# Local run state, protected inputs and migration recovery (never committed)
outputs/
artifacts-local/
artifacts.local.json
/artifacts.codexa-native.local.json
preservation/
validation/
LLM-From-Scratch/

# Shared-infrastructure symlinks (a dir/ rule does not match a symlink)
/build
/preservation
/validation

# Private local status report (machine paths, asset inventory)
/documentation/workspace/CHATGPT_CURRENT_STATE.md

# Editor / tool state
.codex/
.DS_Store
